{
  "name": "mcp-memory-server",
  "version": "2.0.0",
  "description": "PureGate Knowledge — Enterprise vector memory platform with hybrid search, multi-tenancy, and REST API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-memory-server": "dist/index.js",
    "puregate-knowledge": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:mcp": "SERVER_MODE=mcp node dist/index.js",
    "start:http": "SERVER_MODE=http node dist/index.js",
    "start:dual": "SERVER_MODE=dual node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "mcp",
    "memory",
    "vector-search",
    "embeddings",
    "knowledge-management",
    "rag",
    "enterprise",
    "multi-tenant",
    "puregate",
    "pgvector",
    "hybrid-search"
  ],
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "better-sqlite3": "^12.8.0",
    "picomatch": "^4.0.4",
    "sqlite-vec": "^0.1.7",
    "uuid": "^11.1.0",
    "yaml": "^2.8.3",
    "zod": "^3.24.0",
    "fastify": "^5.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "jose": "^6.0.0",
    "pg": "^8.13.0",
    "pgvector": "^0.2.0",
    "ioredis": "^5.4.0",
    "pino": "^9.0.0",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/picomatch": "^3.0.2",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
