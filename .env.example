# ── PureGate Knowledge Configuration ─────────────────────────────────────

# Server Mode: mcp | http | dual (default: dual)
SERVER_MODE=http
PORT=3000
HOST=0.0.0.0

# ── Database ─────────────────────────────────────────────────────────────
# Provider: sqlite | postgres (default: sqlite)
DB_PROVIDER=postgres

# SQLite (local/development)
MCP_MEMORY_DB_PATH=~/.mcp-memory/memory.db

# PostgreSQL (production)
DATABASE_URL=postgresql://puregate:password@localhost:5432/puregate_knowledge
PG_POOL_MIN=2
PG_POOL_MAX=20

# ── Embeddings ───────────────────────────────────────────────────────────
# Provider: transformers | openai | remote (default: transformers)
EMBEDDING_PROVIDER=transformers

# Local Transformers.js
MCP_MEMORY_MODEL=Xenova/all-MiniLM-L6-v2
MCP_MEMORY_DIMENSIONS=384

# OpenAI (production)
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Remote (self-hosted TEI / vLLM)
# EMBEDDING_PROVIDER=remote
# EMBEDDING_ENDPOINT=http://localhost:8080

# ── Authentication ───────────────────────────────────────────────────────
AUTH_ENABLED=true
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_ISSUER=puregate-knowledge
JWT_AUDIENCE=puregate-api
TOKEN_EXPIRY_HOURS=24

# ── Redis Cache ──────────────────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
EMBEDDING_CACHE_TTL=86400
SEARCH_CACHE_TTL=300

# ── Rate Limiting ────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_PRO=1000
RATE_LIMIT_ENTERPRISE=5000

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=false

# ── Monitoring ───────────────────────────────────────────────────────────
METRICS_ENABLED=true
